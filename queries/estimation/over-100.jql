sprint = "$SPRINT_ID" AND board = "$BOARD_ID" AND (
  (customfield_10016 = 1  AND customfield_10028 > 2)     OR
  (customfield_10016 = 2  AND customfield_10028 > 4)     OR
  (customfield_10016 = 3  AND customfield_10028 > 6)     OR
  (customfield_10016 = 5  AND customfield_10028 > 10)    OR
  (customfield_10016 = 8  AND customfield_10028 > 16)    OR
  (customfield_10016 = 13 AND customfield_10028 > 26)
)
